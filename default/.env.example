# Alpha Vantage API key (free): https://www.alphavantage.co/support/#api-key
# Get your own key for full commodity coverage (including gold).
# The demo key only works for a subset of sample endpoints.
# Either name works; ALPHA_VANTAGE_API_KEY is preferred.
# Never commit a real key — keep it in .env (gitignored).
#
# Local compose: entrypoint seeds Airflow Connection `alpha_vantage_default`
# (conn-password = this key; extra = transport / mcp_url / mcp_sse_url).
# Tasks read the key via BaseHook.get_connection, not by treating .env as
# the source of truth. Production should use an Airflow secrets backend
# instead of env-file seeding.
ALPHA_VANTAGE_API_KEY=your_api_key_here
# ALPHA_VANTAGE_KEY=your_api_key_here

# How to talk to Alpha Vantage:
#   http  — remote MCP Streamable HTTP (default, best for Docker)
#           https://mcp.alphavantage.co/mcp?apikey=YOUR_API_KEY
#   sse   — remote MCP HTTP+SSE (legacy transport)
#           https://mcp.alphavantage.co/sse?apikey=YOUR_API_KEY
#   stdio — local MCP server: uvx marketdata-mcp-server YOUR_API_KEY
#           (requires uv/uvx in the Airflow image/host)
#   rest  — legacy www.alphavantage.co/query (not MCP)
# Connection examples: https://mcp.alphavantage.co/#connection-examples
ALPHA_VANTAGE_TRANSPORT=http
# Default: direct Streamable HTTP (Docker Desktop / WSL / typical internet SNAT).
# Do not use :18080 unless you also start docker-compose.mcp-forwarder.yml.
ALPHA_VANTAGE_MCP_URL=https://mcp.alphavantage.co/mcp
ALPHA_VANTAGE_MCP_SSE_URL=https://mcp.alphavantage.co/sse
# Opt-in host-network forwarder (Linux/CI bridges that cannot SNAT only):
#   docker compose -f docker-compose.yml -f docker-compose.mcp-forwarder.yml up -d
# ALPHA_VANTAGE_MCP_URL=https://mcp.alphavantage.co:18080/mcp
# ALPHA_VANTAGE_MCP_SSE_URL=https://mcp.alphavantage.co:18080/sse
# ALPHA_VANTAGE_MCP_STDIO_COMMAND=uvx
# ALPHA_VANTAGE_MCP_STDIO_ARGS=marketdata-mcp-server

# Preferred series interval: monthly (default, best free-tier fit) or daily.
# Copper and wheat are monthly-only on Alpha Vantage regardless of this setting.
ALPHA_VANTAGE_INTERVAL=monthly

# Seconds to wait between Alpha Vantage calls (free tier ~5 req/min).
ALPHA_VANTAGE_REQUEST_PAUSE_SECONDS=15

# Optional signal-model tuning (weights are normalized to sum to 1.0).
# SIGNAL_WEIGHT_MOMENTUM=0.15
# SIGNAL_WEIGHT_MOVING_AVERAGE=0.25
# SIGNAL_WEIGHT_RSI=0.25
# SIGNAL_WEIGHT_MACD=0.25
# SIGNAL_WEIGHT_OBV=0.10
# SIGNAL_BUY_THRESHOLD=0.25
# SIGNAL_SELL_THRESHOLD=-0.25
